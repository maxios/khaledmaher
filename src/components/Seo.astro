---
import { graphOf, serializeJsonLd } from '../lib/schema';
import { site } from '../site.config';

export interface SeoProps {
  /** Leave empty on the home page. Others become "Title · Khaled Maher". */
  title?: string;
  /** Use `title` as it is, for a page whose title already names the site. */
  exactTitle?: boolean;
  description?: string;
  /** Keeps a page out of search results while still letting crawlers follow its links. */
  noindex?: boolean;
  article?: { published: Date; modified?: Date; tags: string[] };
  /** Extra Schema.org nodes for this page. */
  schema?: Array<Record<string, unknown>>;
}

type Props = SeoProps;

const {
  title,
  exactTitle = false,
  description = site.description,
  noindex = false,
  article,
  schema = [],
} = Astro.props;

const pageTitle = title ? (exactTitle ? title : `${title} · ${site.name}`) : site.homeTitle;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/og.png`, Astro.site).href;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={site.name} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={title ?? site.homeTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="I engineer the language people and machines work in. Khaled Maher." />
{
  article && (
    <>
      <meta property="article:published_time" content={article.published.toISOString()} />
      <meta
        property="article:modified_time"
        content={(article.modified ?? article.published).toISOString()}
      />
      <meta property="article:author" content={new URL('about/', Astro.site).href} />
      {article.tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={site.social.xHandle} />
<meta name="twitter:creator" content={site.social.xHandle} />

<script is:inline type="application/ld+json" set:html={serializeJsonLd(graphOf(...schema))} />
