---
interface Props {
  direction?: 'left' | 'right';
}

const { direction = 'right' } = Astro.props;
---

<svg
  class="arrow"
  viewBox="0 0 24 24"
  width="18"
  height="18"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    direction === 'right' ? (
      <path d="M5 12h14M12 5l7 7-7 7" />
    ) : (
      <path d="M19 12H5M12 19l-7-7 7-7" />
    )
  }
</svg>
