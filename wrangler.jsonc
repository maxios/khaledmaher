{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "khaledmaher",
  "account_id": "6dbce347b834044f4d24fcc474a1d673",
  "compatibility_date": "2026-11-06",
  // A static site: Cloudflare serves dist/ and no Worker code runs.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // These only work while both hostnames have proxied DNS records.
  "routes": [
    { "pattern": "khaledmaher.com/*", "zone_name": "khaledmaher.com" },
    { "pattern": "www.khaledmaher.com/*", "zone_name": "khaledmaher.com" }
  ],
  "workers_dev": false,
  "preview_urls": false
}
